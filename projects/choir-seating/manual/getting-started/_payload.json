[{"data":1,"prerenderedAt":142},["ShallowReactive",2],{"choir-manual-toc":3,"choir-manual-getting-started":40},[4,8,12,16,20,24,28,32,36],{"path":5,"title":6,"order":7},"/choir-manual/getting-started","Getting started",1,{"path":9,"title":10,"order":11},"/choir-manual/choir-setup","Choir setup",2,{"path":13,"title":14,"order":15},"/choir-manual/the-stage","The stage",3,{"path":17,"title":18,"order":19},"/choir-manual/arranging","Arranging",4,{"path":21,"title":22,"order":23},"/choir-manual/neighbour-check","Neighbour check",5,{"path":25,"title":26,"order":27},"/choir-manual/seating-plans","Seating plans",6,{"path":29,"title":30,"order":31},"/choir-manual/walk-on-order","Walk-on order",7,{"path":33,"title":34,"order":35},"/choir-manual/print-and-export","Printing and export",8,{"path":37,"title":38,"order":39},"/choir-manual/settings-and-backup","Settings and backup",9,{"id":41,"title":6,"body":42,"description":135,"extension":136,"meta":137,"navigation":138,"order":7,"path":5,"seo":139,"stem":140,"__hash__":141},"choirmanual/choir-manual/getting-started.md",{"type":43,"value":44,"toc":131},"minimark",[45,49,58,65,73,78,124],[46,47,6],"h1",{"id":48},"getting-started",[50,51,52,53,57],"p",{},"Choir Seating arranges a choir on stage so that ",[54,55,56],"strong",{},"every singer sits next to someone singing the same part",", in every piece of the concert at once. You set up your choir, it works out a seating, and you adjust it by hand.",[50,59,60],{},[61,62],"img",{"alt":63,"src":64},"The arranger with a concert open","/choir-seating/manual/overview.png",[50,66,67,68,72],{},"It runs in your browser. There is no account and nothing is sent anywhere: your choir is saved in this browser, on this device. ",[69,70,38],"a",{"href":71},"/projects/choir-seating/manual/settings-and-backup"," explains how to move it to another one.",[74,75,77],"h2",{"id":76},"a-first-plan-in-four-steps","A first plan in four steps",[79,80,81,92,105,115],"ol",{},[82,83,84,87,88,91],"li",{},[54,85,86],{},"Set up the choir."," Add your singers, make a concert and say how the sections split. See ",[69,89,10],{"href":90},"/projects/choir-seating/manual/choir-setup",".",[82,93,94,97,98,101,102,91],{},[54,95,96],{},"Arrange."," Set the size of the stage and press ",[54,99,100],{},"Auto-arrange",". See ",[69,103,18],{"href":104},"/projects/choir-seating/manual/arranging",[82,106,107,110,111,91],{},[54,108,109],{},"Adjust by hand."," Drag singers to swap them, and lock the ones who must stay put. See ",[69,112,114],{"href":113},"/projects/choir-seating/manual/arranging#moving-singers","Moving singers",[82,116,117,120,121,91],{},[54,118,119],{},"Print and export."," Print the plan or save it as a PDF, or export it as a spreadsheet. See ",[69,122,34],{"href":123},"/projects/choir-seating/manual/print-and-export",[50,125,126,127,130],{},"Under the stage, the ",[69,128,22],{"href":129},"/projects/choir-seating/manual/neighbour-check"," tells you whether anyone has been left without a neighbour, and shows you who.",{"title":132,"searchDepth":11,"depth":11,"links":133},"",[134],{"id":76,"depth":11,"text":77},"What Choir Seating does, and a first seating plan in four steps.","md",{},true,{"title":6,"description":135},"choir-manual/getting-started","Bw2I1dDFBLth7aQdee4pAq121Pe87SMGVpoP0sII-2o",1791117180878]
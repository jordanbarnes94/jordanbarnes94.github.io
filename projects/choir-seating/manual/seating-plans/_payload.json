[{"data":1,"prerenderedAt":137},["ShallowReactive",2],{"choir-manual-toc":3,"choir-manual-seating-plans":40},[4,8,12,16,20,24,28,32,36],{"path":5,"title":6,"order":7},"/choir-manual/getting-started","Getting started",1,{"path":9,"title":10,"order":11},"/choir-manual/choir-setup","Choir setup",2,{"path":13,"title":14,"order":15},"/choir-manual/the-stage","The stage",3,{"path":17,"title":18,"order":19},"/choir-manual/arranging","Arranging",4,{"path":21,"title":22,"order":23},"/choir-manual/neighbour-check","Neighbour check",5,{"path":25,"title":26,"order":27},"/choir-manual/seating-plans","Seating plans",6,{"path":29,"title":30,"order":31},"/choir-manual/walk-on-order","Walk-on order",7,{"path":33,"title":34,"order":35},"/choir-manual/print-and-export","Printing and export",8,{"path":37,"title":38,"order":39},"/choir-manual/settings-and-backup","Settings and backup",9,{"id":41,"title":26,"body":42,"description":130,"extension":131,"meta":132,"navigation":133,"order":27,"path":25,"seo":134,"stem":135,"__hash__":136},"choirmanual/choir-manual/seating-plans.md",{"type":43,"value":44,"toc":125},"minimark",[45,49,58,65,70,81,101,105,110,117],[46,47,26],"h1",{"id":48},"seating-plans",[50,51,52,53,57],"p",{},"A concert can have as many seating plans as you like: one per piece, or a few ideas to compare. The ",[54,55,56],"strong",{},"Seating plan"," bar at the top picks the one on the stage.",[50,59,60],{},[61,62],"img",{"alt":63,"src":64},"The seating plan bar","/choir-seating/manual/planbar.png",[66,67,69],"h2",{"id":68},"saving","Saving",[50,71,72,73,76,77,80],{},"Changes on the stage are yours to keep or not. ",[54,74,75],{},"Save changes"," writes them into the plan; the button reads ",[54,78,79],{},"Saved"," when there is nothing new. Switching to another plan with unsaved changes asks first.",[82,83,84,91],"ul",{},[85,86,87,90],"li",{},[54,88,89],{},"Duplicate"," makes a new plan from what is on the stage, including any unsaved changes, and leaves the original as it was saved.",[85,92,93,96,97,100],{},[54,94,95],{},"Rename…"," and ",[54,98,99],{},"Delete"," work on the open plan. A concert always keeps at least one plan.",[66,102,104],{"id":103},"preview-alongside","Preview alongside",[50,106,107,109],{},[54,108,104],{}," shows another plan, from this concert or any other, below the stage so you can compare them. Previews can't be edited. You can add as many as you like, and close each one when you are done.",[50,111,112,113,116],{},"In ",[54,114,115],{},"By section"," view, each section shows the same section from every preview beside it.",[50,118,119],{},[61,120],{"alt":121,"src":122,"className":123},"A plan previewed alongside","/choir-seating/manual/preview.png",[124],"wide",{"title":126,"searchDepth":11,"depth":11,"links":127},"",[128,129],{"id":68,"depth":11,"text":69},{"id":103,"depth":11,"text":104},"Several plans per concert, saving changes, and previewing another plan alongside.","md",{},true,{"title":26,"description":130},"choir-manual/seating-plans","O-IzStAK-I0PTIaFVHJhxK3c8AanMD_katsTSzv6jdI",1790807267813]
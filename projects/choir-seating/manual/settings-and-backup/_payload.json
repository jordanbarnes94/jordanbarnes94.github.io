[{"data":1,"prerenderedAt":175},["ShallowReactive",2],{"choir-manual-toc":3,"choir-manual-settings-and-backup":40},[4,8,12,16,20,24,28,32,36],{"path":5,"title":6,"order":7},"/choir-manual/getting-started","Getting started",1,{"path":9,"title":10,"order":11},"/choir-manual/choir-setup","Choir setup",2,{"path":13,"title":14,"order":15},"/choir-manual/the-stage","The stage",3,{"path":17,"title":18,"order":19},"/choir-manual/arranging","Arranging",4,{"path":21,"title":22,"order":23},"/choir-manual/neighbour-check","Neighbour check",5,{"path":25,"title":26,"order":27},"/choir-manual/seating-plans","Seating plans",6,{"path":29,"title":30,"order":31},"/choir-manual/walk-on-order","Walk-on order",7,{"path":33,"title":34,"order":35},"/choir-manual/print-and-export","Printing and export",8,{"path":37,"title":38,"order":39},"/choir-manual/settings-and-backup","Settings and backup",9,{"id":41,"title":38,"body":42,"description":168,"extension":169,"meta":170,"navigation":171,"order":39,"path":37,"seo":172,"stem":173,"__hash__":174},"choirmanual/choir-manual/settings-and-backup.md",{"type":43,"value":44,"toc":163},"minimark",[45,49,65,71,125,130,137,140,160],[46,47,38],"h1",{"id":48},"settings-and-backup",[50,51,52,53,57,58,60,61,64],"p",{},"The ",[54,55,56],"strong",{},"cogwheel"," beside ",[54,59,10],{}," opens ",[54,62,63],{},"Settings",".",[50,66,67],{},[68,69],"img",{"alt":63,"src":70},"/choir-seating/manual/settings.png",[72,73,74,109,119],"ul",{},[75,76,77,80,81],"li",{},[54,78,79],{},"Colours",": named colour schemes, the same in every concert.\n",[72,82,83,89,103],{},[75,84,85,88],{},[54,86,87],{},"Section colours",": the fill of each section's seats.",[75,90,91,94,95,98,99,102],{},[54,92,93],{},"Split frames",": the frame colour for each part of a split, a row per section. A split's first part uses column ",[54,96,97],{},"1",", its second column ",[54,100,101],{},"2",", and so on.",[75,104,105,108],{},[54,106,107],{},"Preview",": a singer from each section with its frame in four quarters, one per part, numbered at the corners, so you can see how the frames look on that section's fill.",[75,110,111,114,115,64],{},[54,112,113],{},"Audience and seat labelling",": which way round the plan is drawn and how chairs are labelled. See ",[116,117,34],"a",{"href":118},"/projects/choir-seating/manual/print-and-export#which-way-round",[75,120,121,124],{},[54,122,123],{},"Backup and restore"," (below).",[126,127,129],"h2",{"id":128},"where-your-work-is-kept","Where your work is kept",[50,131,132,133,136],{},"Everything is saved in this browser as you go, so it is still there when you come back. But it lives ",[54,134,135],{},"only in this browser, on this device",". Clearing your browser's site data, or using a private window, loses it.",[126,138,123],{"id":139},"backup-and-restore",[72,141,142,148,154],{},[75,143,144,147],{},[54,145,146],{},"Save backup file"," writes every roster, concert, seating plan and colour scheme into one file. Keep it somewhere safe, or take it to another device.",[75,149,150,153],{},[54,151,152],{},"Restore from backup"," loads a backup file, replacing everything this tool holds.",[75,155,156,159],{},[54,157,158],{},"Clear everything"," deletes every roster, concert and seating plan and starts again from the example choir. Your colour schemes are kept.",[50,161,162],{},"Save a backup before a big change, and whenever you have done work you wouldn't want to lose.",{"title":164,"searchDepth":11,"depth":11,"links":165},"",[166,167],{"id":128,"depth":11,"text":129},{"id":139,"depth":11,"text":123},"Colours, seat labelling, and keeping a backup.","md",{},true,{"title":38,"description":168},"choir-manual/settings-and-backup","aiOqlo--XIDqj5ypHWGdulXgagCHe-ugXHp86g27tyg",1791027352033]
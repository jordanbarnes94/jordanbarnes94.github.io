out.",[50,100,101,104],{},[54,102,103],{},"Colour by split"," picks one split to show as a coloured frame round each chair, so you can see where each part of that split sits. It only changes the colours: the arranger always seats for every split at once.",[50,106,107,110],{},[54,108,109],{},"Seat labels"," shows or hides the row and column headings round the full stage.",[67,112,114],{"id":113},"grid-size","Grid size",[50,116,117],{},[61,118],{"alt":114,"src":119},"/choir-seating/manual/gridsize.png",[50,121,122,125,126,129],{},[54,123,124],{},"Rows"," and ",[54,127,128],{},"Columns"," set the size of the stage. Changing them keeps everyone in their chair; anyone left off the edge goes to the waiting area.",[50,131,132,133,137],{},"To move singers, fill the stage automatically, or leave gaps in it, see ",[134,135,18],"a",{"href":136},"/projects/choir-seating/manual/arranging",".",{"title":139,"searchDepth":11,"depth":11,"links":140},"",[141,142],{"id":69,"depth":11,"text":70},{"id":113,"depth":11,"text":114},"Reading the stage, the two views, colouring by split, and grid size.","md",{},true,{"title":14,"description":143},"choir-manual/the-stage","V61MMlYgcnS2SD_4S6CNt12I1wT7e7CznGQupxSu43c",1790948963107]
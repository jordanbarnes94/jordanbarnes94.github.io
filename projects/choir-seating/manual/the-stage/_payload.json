[{"data":1,"prerenderedAt":138},["ShallowReactive",2],{"choir-manual-toc":3,"choir-manual-the-stage":40},[4,8,12,16,20,24,28,32,36],{"path":5,"title":6,"order":7},"/choir-manual/getting-started","Getting started",1,{"path":9,"title":10,"order":11},"/choir-manual/choir-setup","Choir setup",2,{"path":13,"title":14,"order":15},"/choir-manual/the-stage","The stage",3,{"path":17,"title":18,"order":19},"/choir-manual/arranging","Arranging",4,{"path":21,"title":22,"order":23},"/choir-manual/neighbour-check","Neighbour check",5,{"path":25,"title":26,"order":27},"/choir-manual/seating-plans","Seating plans",6,{"path":29,"title":30,"order":31},"/choir-manual/walk-on-order","Walk-on order",7,{"path":33,"title":34,"order":35},"/choir-manual/print-and-export","Printing and export",8,{"path":37,"title":38,"order":39},"/choir-manual/settings-and-backup","Settings and backup",9,{"id":41,"title":14,"body":42,"description":131,"extension":132,"meta":133,"navigation":134,"order":15,"path":13,"seo":135,"stem":136,"__hash__":137},"choirmanual/choir-manual/the-stage.md",{"type":43,"value":44,"toc":126},"minimark",[45,49,58,66,71,77,93,99,103,108,118],[46,47,14],"h1",{"id":48},"the-stage",[50,51,52,53,57],"p",{},"The stage is a fixed grid of chairs, drawn as the audience sees it: the ",[54,55,56],"strong",{},"front row is at the bottom",", nearest the audience. Each chair is filled with its singer's section colour.",[50,59,60],{},[61,62],"img",{"alt":14,"src":63,"className":64},"/choir-seating/manual/stage.png",[65],"wide",[67,68,70],"h2",{"id":69},"views","Views",[50,72,73],{},[61,74],{"alt":75,"src":76},"The view bar","/choir-seating/manual/viewbar.png",[78,79,80,87],"ul",{},[81,82,83,86],"li",{},[54,84,85],{},"Full stage"," shows every chair.",[81,88,89,92],{},[54,90,91],{},"By section"," shows each section on its own, cut out of the same stage with everyone else greyed out.",[50,94,95,98],{},[54,96,97],{},"Colour by split"," picks one split to show as a coloured frame round each chair, so you can see where each part of that split sits. It only changes the colours: the arranger always seats for every split at once.",[67,100,102],{"id":101},"grid-size","Grid size",[50,104,105],{},[61,106],{"alt":102,"src":107},"/choir-seating/manual/gridsize.png",[50,109,110,113,114,117],{},[54,111,112],{},"Rows"," and ",[54,115,116],{},"Columns"," set the size of the stage. Changing them keeps everyone in their chair; anyone left off the edge goes to the waiting area.",[50,119,120,121,125],{},"To move singers, fill the stage automatically, or leave gaps in it, see ",[122,123,18],"a",{"href":124},"/projects/choir-seating/manual/arranging",".",{"title":127,"searchDepth":11,"depth":11,"links":128},"",[129,130],{"id":69,"depth":11,"text":70},{"id":101,"depth":11,"text":102},"Reading the stage, the two views, colouring by split, and grid size.","md",{},true,{"title":14,"description":131},"choir-manual/the-stage","dQ5TgdBTMU4D6W-jxtlZRABDlAs4aQNMpJH2Qe1B9h8",1790807909947]
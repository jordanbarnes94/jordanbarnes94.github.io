[{"data":1,"prerenderedAt":169},["ShallowReactive",2],{"choir-manual-toc":3,"choir-manual-walk-on-order":40},[4,8,12,16,20,24,28,32,36],{"path":5,"title":6,"order":7},"/choir-manual/getting-started","Getting started",1,{"path":9,"title":10,"order":11},"/choir-manual/choir-setup","Choir setup",2,{"path":13,"title":14,"order":15},"/choir-manual/the-stage","The stage",3,{"path":17,"title":18,"order":19},"/choir-manual/arranging","Arranging",4,{"path":21,"title":22,"order":23},"/choir-manual/neighbour-check","Neighbour check",5,{"path":25,"title":26,"order":27},"/choir-manual/seating-plans","Seating plans",6,{"path":29,"title":30,"order":31},"/choir-manual/walk-on-order","Walk-on order",7,{"path":33,"title":34,"order":35},"/choir-manual/print-and-export","Printing and export",8,{"path":37,"title":38,"order":39},"/choir-manual/settings-and-backup","Settings and backup",9,{"id":41,"title":30,"body":42,"description":162,"extension":163,"meta":164,"navigation":165,"order":31,"path":29,"seo":166,"stem":167,"__hash__":168},"choirmanual/choir-manual/walk-on-order.md",{"type":43,"value":44,"toc":157},"minimark",[45,49,57,66,92,97,123,130,134,137],[46,47,30],"h1",{"id":48},"walk-on-order",[50,51,52,53,56],"p",{},"The walk-on order is the order singers file onto the stage, so a queue can form backstage. Open ",[54,55,30],"strong",{}," under the stage. While it is open, every chair shows its number in the queue.",[50,58,59],{},[60,61],"img",{"alt":62,"className":63,"src":65},"The walk-on order",[64],"wide","/choir-seating/manual/walkon.png",[67,68,69,76,89],"ul",{},[70,71,72,75],"li",{},[54,73,74],{},"First row on",": the back row or the front row first.",[70,77,78,81,82,85,86,88],{},[54,79,80],{},"Enter from",": the left or right wing, as the audience sees the stage, or ",[54,83,84],{},"Both",". ",[54,87,84],{}," makes two queues, one at each wing, that meet at the aisle; choose which column they meet after.",[70,90,91],{},"Each row fills from the far end, so nobody squeezes past anyone already standing.",[93,94,96],"h2",{"id":95},"setting-each-row","Setting each row",[50,98,99,102,103,106,107,110,111,113,114,117,118,110,120,122],{},[54,100,101],{},"Set each row"," lists the rows in the order they walk on. The arrows move a row earlier or later, and ",[54,104,105],{},"Left",", ",[54,108,109],{},"Right"," and ",[54,112,84],{}," give it its own direction. ",[54,115,116],{},"Reset to default"," puts every row back to ",[54,119,74],{},[54,121,80],{},".",[50,124,125],{},[60,126],{"alt":127,"className":128,"src":129},"Each row set on its own",[64],"/choir-seating/manual/walkon-rows.png",[93,131,133],{"id":132},"taking-the-list-away","Taking the list away",[50,135,136],{},"The list underneath is the queue:",[67,138,139,145,151],{},[70,140,141,144],{},[54,142,143],{},"Copy as text"," puts it on the clipboard, for an email or a document.",[70,146,147,150],{},[54,148,149],{},"Download CSV"," saves it as a spreadsheet.",[70,152,153,156],{},[54,154,155],{},"Print"," prints it on its own, A4 portrait, one column per row.",{"title":158,"searchDepth":11,"depth":11,"links":159},"",[160,161],{"id":95,"depth":11,"text":96},{"id":132,"depth":11,"text":133},"The order singers file on, so a queue can form backstage.","md",{},true,{"title":30,"description":162},"choir-manual/walk-on-order","kVguEqBD1dQxgIZsotCgeZl50uKXrqZrB71o4tZuuCM",1790807267813]
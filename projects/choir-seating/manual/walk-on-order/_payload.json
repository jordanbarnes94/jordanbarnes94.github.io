[{"data":1,"prerenderedAt":176},["ShallowReactive",2],{"choir-manual-toc":3,"choir-manual-walk-on-order":40},[4,8,12,16,20,24,28,32,36],{"path":5,"title":6,"order":7},"/choir-manual/getting-started","Getting started",1,{"path":9,"title":10,"order":11},"/choir-manual/choir-setup","Choir setup",2,{"path":13,"title":14,"order":15},"/choir-manual/the-stage","The stage",3,{"path":17,"title":18,"order":19},"/choir-manual/arranging","Arranging",4,{"path":21,"title":22,"order":23},"/choir-manual/neighbour-check","Neighbour check",5,{"path":25,"title":26,"order":27},"/choir-manual/seating-plans","Seating plans",6,{"path":29,"title":30,"order":31},"/choir-manual/walk-on-order","Walk-on order",7,{"path":33,"title":34,"order":35},"/choir-manual/print-and-export","Printing and export",8,{"path":37,"title":38,"order":39},"/choir-manual/settings-and-backup","Settings and backup",9,{"id":41,"title":30,"body":42,"description":169,"extension":170,"meta":171,"navigation":172,"order":31,"path":29,"seo":173,"stem":174,"__hash__":175},"choirmanual/choir-manual/walk-on-order.md",{"type":43,"value":44,"toc":164},"minimark",[45,49,64,73,99,104,130,137,141,144],[46,47,30],"h1",{"id":48},"walk-on-order",[50,51,52,53,56,57,60,61,63],"p",{},"The walk-on order is the order singers file onto the stage, so a queue can form backstage. It has its own tab: click ",[54,55,30],"strong",{}," beside ",[54,58,59],{},"Arrange",", above the stage. The tab shows the walk-on settings, the stage with every chair's number in the queue in its bottom-right corner, and the list. The stage there is for checking, not arranging: to move someone, go back to ",[54,62,59],{},", where the split labels show again.",[50,65,66],{},[67,68],"img",{"alt":69,"className":70,"src":72},"The walk-on order",[71],"wide","/choir-seating/manual/walkon.png",[74,75,76,83,96],"ul",{},[77,78,79,82],"li",{},[54,80,81],{},"First row on",": the back row or the front row first.",[77,84,85,88,89,92,93,95],{},[54,86,87],{},"Enter from",": the left or right wing, as the audience sees the stage, or ",[54,90,91],{},"Both",". ",[54,94,91],{}," makes two queues, one at each wing, that meet at the aisle; choose which column they meet after.",[77,97,98],{},"Each row fills from the far end, so nobody squeezes past anyone already standing.",[100,101,103],"h2",{"id":102},"setting-each-row","Setting each row",[50,105,106,109,110,113,114,117,118,92,120,123,124,126,127,129],{},[54,107,108],{},"Set each row"," lists the rows in the order they walk on. The arrows move a row earlier or later, and the picker beside them gives it its own direction: ",[54,111,112],{},"Left",", ",[54,115,116],{},"Right"," or ",[54,119,91],{},[54,121,122],{},"Reset to default"," puts every row back to ",[54,125,81],{}," and ",[54,128,87],{},".",[50,131,132],{},[67,133],{"alt":134,"className":135,"src":136},"Each row set on its own",[71],"/choir-seating/manual/walkon-rows.png",[100,138,140],{"id":139},"taking-the-list-away","Taking the list away",[50,142,143],{},"The list underneath is the queue:",[74,145,146,152,158],{},[77,147,148,151],{},[54,149,150],{},"Copy as text"," puts it on the clipboard, for an email or a document.",[77,153,154,157],{},[54,155,156],{},"Download spreadsheet"," saves it as a CSV file, which opens in Excel.",[77,159,160,163],{},[54,161,162],{},"Print"," prints it on its own, A4 portrait, one column per row.",{"title":165,"searchDepth":11,"depth":11,"links":166},"",[167,168],{"id":102,"depth":11,"text":103},{"id":139,"depth":11,"text":140},"The order singers file on, so a queue can form backstage.","md",{},true,{"title":30,"description":169},"choir-manual/walk-on-order","3o2nJk1IAQ7yqKbEWlzfLK5fEWAuByeU-9Q5AX1r1tI",1790948963107]
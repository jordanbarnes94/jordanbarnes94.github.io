[{"data":1,"prerenderedAt":111},["ShallowReactive",2],{"/recipes/bran-muffins/":3,"/recipes/bran-muffins/-related":110},{"id":4,"title":5,"body":6,"cookTime":11,"course":8,"description":7,"difficulty":12,"extension":82,"kind":83,"meta":84,"navigation":103,"path":104,"prepTime":10,"quote":105,"related":105,"seo":106,"servings":9,"stem":107,"tags":108,"__hash__":109},"recipes/recipes/bran-muffins.json","Bran Muffins",{"title":5,"description":7,"course":8,"servings":9,"prepTime":10,"cookTime":11,"difficulty":12,"tags":13,"equipment":18,"ingredients":24,"method":74,"notes":80},"Wholewheat bran and raisin muffins made with yogurt, apple sauce and olive oil","Baking & Desserts","12 muffins","20 minutes (ready in 45 minutes in all)","20 to 23 minutes","Easy",[14,15,16,17],"muffins","baking","breakfast","bran",[19,20,21,22,23],"medium bowl","large bowl","whisk","12-cup muffin pan","wooden skewer",[25,29,33,36,39,42,45,49,53,57,61,65,67,70],{"item":26,"amount":27,"notes":28},"whole wheat flour","226 grams","2 cups",{"item":30,"amount":31,"notes":32},"baking powder","2 teaspoons","",{"item":34,"amount":35,"notes":32},"baking soda","1 teaspoon",{"item":37,"amount":38,"notes":32},"ground cinnamon","3/4 teaspoon",{"item":40,"amount":41,"notes":32},"freshly grated nutmeg","1/4 teaspoon",{"item":43,"amount":44,"notes":32},"eggs","2 large",{"item":46,"amount":47,"notes":48},"full-fat strained yogurt","340 grams","1 ½ cups, like Greek yogurt or skyr (not labne)",{"item":50,"amount":51,"notes":52},"apple sauce","255 grams","1 cup",{"item":54,"amount":55,"notes":56},"maple syrup or honey","80 grams","¼ cup",{"item":58,"amount":59,"notes":60},"olive oil","75 grams","6 tablespoons",{"item":62,"amount":63,"notes":64},"Diamond Crystal kosher salt","1 1/2 teaspoons","or 3/4 teaspoon fine salt",{"item":66,"amount":63,"notes":32},"vanilla extract or paste",{"item":68,"amount":69,"notes":28},"wheat bran","128 grams",{"item":71,"amount":72,"notes":73},"raisins","225 grams","1 ½ cups",[75,76,77,78,79],"In a medium bowl, whisk together the flour, baking powder, baking soda, cinnamon, and nutmeg; set aside.","In a large bowl, whisk the eggs thoroughly, then whisk in the yogurt, apple sauce, maple syrup, olive oil, salt, and vanilla. Stir in the bran and raisins into the yogurt mixture and let sit while the oven heats up.","Set a rack in the center of the oven and heat to 190°C. Butter or line a 12-cup muffin pan.","Stir the flour mixture into the bran mixture until just combined, then divide the batter between the muffin cups. (The batter will pile high into the cups.) Bake until a wooden skewer inserted into a muffin comes out free of crumbs but feels slightly sticky, 20 to 23 minutes.","Cool for at least 15 minutes before eating. Store in an airtight container at room temperature for 5 days, or place in a zip-top bag and freeze for 3 months. Split and toast to reheat.",[81],"Source: Sohla El-Waylly.","json","recipe",{"equipment":85,"ingredients":86,"method":101,"notes":102},[19,20,21,22,23],[87,88,89,90,91,92,93,94,95,96,97,98,99,100],{"item":26,"amount":27,"notes":28},{"item":30,"amount":31,"notes":32},{"item":34,"amount":35,"notes":32},{"item":37,"amount":38,"notes":32},{"item":40,"amount":41,"notes":32},{"item":43,"amount":44,"notes":32},{"item":46,"amount":47,"notes":48},{"item":50,"amount":51,"notes":52},{"item":54,"amount":55,"notes":56},{"item":58,"amount":59,"notes":60},{"item":62,"amount":63,"notes":64},{"item":66,"amount":63,"notes":32},{"item":68,"amount":69,"notes":28},{"item":71,"amount":72,"notes":73},[75,76,77,78,79],[81],true,"/recipes/bran-muffins",null,{"title":5,"description":7},"recipes/bran-muffins",[14,15,16,17],"O3ZOUT0TApQycuJNQOekRQLQ9bURsoBkUNLaTtXzNZE",[],1792600019806]
[{"data":1,"prerenderedAt":108},["ShallowReactive",2],{"/recipes/granola-bars/":3,"/recipes/granola-bars/-related":107},{"id":4,"title":5,"body":6,"cookTime":11,"course":8,"description":7,"difficulty":12,"extension":80,"kind":81,"meta":82,"navigation":100,"path":101,"prepTime":10,"quote":102,"related":102,"seo":103,"servings":9,"stem":104,"tags":105,"__hash__":106},"recipes/recipes/granola-bars.json","Granola Bars",{"title":5,"description":7,"course":8,"servings":9,"prepTime":10,"cookTime":11,"difficulty":12,"tags":13,"equipment":17,"ingredients":24,"method":65,"notes":78},"Baked oat bars with honey and puffed cereal, plus raisins and chocolate chips if you want them","Baking & Desserts","about 24 bars","20 minutes","18-22 minutes","Easy",[14,15,16],"oats","baking","snack",[18,19,20,21,22,23],"11x17 cookie sheet","parchment paper","large mixing bowl","waxed paper","rolling pin","pizza cutter",[25,29,33,36,39,42,44,47,50,53,57,60,62],{"item":26,"amount":27,"notes":28},"butter","2/3 cup","softened",{"item":30,"amount":31,"notes":32},"honey","1/2 cup","",{"item":34,"amount":35,"notes":32},"brown sugar","1/4 cup packed",{"item":37,"amount":38,"notes":32},"egg","1",{"item":40,"amount":41,"notes":32},"baking soda","1 tsp",{"item":43,"amount":41,"notes":32},"vanilla extract",{"item":45,"amount":46,"notes":32},"flour","1 cup",{"item":48,"amount":49,"notes":32},"wheat germ","1/4 cup",{"item":51,"amount":46,"notes":52},"puffed cereal","I used puffed rice",{"item":54,"amount":55,"notes":56},"rolled oats","4 cups","approximately",{"item":58,"amount":46,"notes":59},"raisins","optional",{"item":61,"amount":46,"notes":59},"chocolate chips",{"item":63,"amount":49,"notes":64},"water","approximately, if needed",[66,67,68,69,70,71,72,73,74,75,76,77],"Preheat oven to 165°C. Prepare pan — I used an 11x17 cookie sheet lined with parchment paper.","Cream butter, sugar, and honey together.","Add egg, beat thoroughly until smooth.","Stir in baking soda and vanilla.","Stir in flour.","Add wheat germ and puffed cereal.","Stir in optional goodies of your choice, about a cup of each.","Stir in oats, lots of 'em. Cram your mixing bowl full of oats.","If the mixture seems a bit crumbly, add water to make it a bit stickier, but not sloppy.","Let the mixture sit for a few minutes to let the whole grains absorb the water.","Turn the mixture out into the prepared pan and press it down (I wore vinyl gloves to keep my hands from getting gloppy). Cover with waxed paper and roll it firmly with a rolling pin — this makes the bars firm and less likely to crumble.","Bake at 165°C for 18 to 22 minutes, until golden brown. Let cool for ten minutes, then cut into bars (a pizza cutter works great). Let the bars cool completely in the pan before removing.",[79],"May be frozen.","json","recipe",{"equipment":83,"ingredients":84,"method":98,"notes":99},[18,19,20,21,22,23],[85,86,87,88,89,90,91,92,93,94,95,96,97],{"item":26,"amount":27,"notes":28},{"item":30,"amount":31,"notes":32},{"item":34,"amount":35,"notes":32},{"item":37,"amount":38,"notes":32},{"item":40,"amount":41,"notes":32},{"item":43,"amount":41,"notes":32},{"item":45,"amount":46,"notes":32},{"item":48,"amount":49,"notes":32},{"item":51,"amount":46,"notes":52},{"item":54,"amount":55,"notes":56},{"item":58,"amount":46,"notes":59},{"item":61,"amount":46,"notes":59},{"item":63,"amount":49,"notes":64},[66,67,68,69,70,71,72,73,74,75,76,77],[79],true,"/recipes/granola-bars",null,{"title":5,"description":7},"recipes/granola-bars",[14,15,16],"9C8f2fXh7noWj6fuaOATGCpgKaUuEYc-U2T7CMJIjqA",[],1793160972838]